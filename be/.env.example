# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster> with your Atlas values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hms?retryWrites=true&w=majority

# Frontend URL(s) for CORS — comma-separated for local + Vercel
# Example: http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Better Auth — generate a long random secret (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public URL of this API (used for auth cookies / base URL)
BETTER_AUTH_URL=http://localhost:5000

# Order pricing (decimals). Defaults: tax 15%, service charge 10%
TAX_RATE=0.15
SERVICE_CHARGE_RATE=0.10
